# Contact form (Resend). Copy to .env.local and fill in, and set the same
# values in Netlify → Site settings → Environment variables.

# Required: API key from https://resend.com (free tier).
RESEND_API_KEY=

# Optional. Where contact-form messages are delivered.
# Defaults to the email in src/data/resume.tsx.
# NOTE: until you verify a domain in Resend, this MUST be the email you
# signed up to Resend with.
CONTACT_TO_EMAIL=

# Optional. The "from" address. Until you verify your own domain in Resend,
# leave this as the shared onboarding sender.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
